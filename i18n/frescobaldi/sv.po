msgid "Use inline style when copying colored HTML"
msgstr "Använd stilattribut när färglagd HTML kopieras"

#: ../../frescobaldi/preferences/editor.py:332
msgid ""
"If enabled, inline style attributes are used when copying colored HTML to "
"the clipboard. Otherwise, a CSS stylesheet is embedded."
msgstr ""
"Skriv formateringen direkt i HTML-elementens stilattribut när färglagd HTML "
"kopieras till urklipp. Annars bäddas en CSS-formatmall in."

#: ../../frescobaldi/preferences/editor.py:336
msgid "Use inline style when exporting colored HTML"
msgstr "Använd stilattribut när färglagd HTML exporteras"

#: ../../frescobaldi/preferences/editor.py:338
