msgstr "&Modal transponering..."

#: ../../frescobaldi/pitch/__init__.py:179
msgid "Transposes all notes in the document or selection within a given mode."
msgstr ""
"Transponerar alla toner i dokumentet eller markeringen inom en given skala."

#: ../../frescobaldi/pitch/__init__.py:180
msgid "Mode shift..."
msgstr "Byt tonskala..."

#: ../../frescobaldi/pitch/__init__.py:182
