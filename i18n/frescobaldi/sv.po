#: ../../linux/org.frescobaldi.Frescobaldi.desktop.in:2
#: ../../linux/org.frescobaldi.Frescobaldi.desktop.in:3
#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:4
msgid "Frescobaldi"
msgstr "Frescobaldi"

#: ../../linux/org.frescobaldi.Frescobaldi.desktop.in:4
msgid "Write LilyPond music sheets"
msgstr "Skriv noter med LilyPond"

#: ../../linux/org.frescobaldi.Frescobaldi.desktop.in:8
msgid "org.frescobaldi.Frescobaldi"
msgstr "org.frescobaldi.Frescobaldi"

#: ../../linux/org.frescobaldi.Frescobaldi.desktop.in:13
msgid ""
"editor;leadsheet;lilypond;music notation;musicxml;score;scorewriter;sheet "
"music;tablature;"
msgstr ""
"redigerare;melodiblad;lilypond;notskrift;musicxml;partitur;notskrivning;noter;tabulatur;"

#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:5
msgid "Write beautiful music sheets"
msgstr "Skapa vackra notblad"

#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:9
msgid "Frescobaldi project"
msgstr "Frescobaldi-projektet"

#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:13
msgid ""
"Frescobaldi is an advanced text editor to edit LilyPond sheet music files. "
"It aims to be powerful, yet lightweight and easy to use."
msgstr ""
"Frescobaldi är en avancerad textredigerare för notfiler i LilyPond-format. "
"Målet är ett kraftfullt program som kräver få resurser och är lätt att "
"använda."

#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:17
msgid "Features:"
msgstr "Funktioner:"

#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:19
msgid ""
"Powerful text editor with syntax highlighting, automatic completion, auto-"
"indent, and code formatting"
msgstr ""
"Textredigerare med syntaxmarkering, automatisk komplettering, automatiska "
"indrag och kodformatering"

#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:20
msgid "Music view with advanced Point & Click"
msgstr "Musikvy där du kan klicka på en not för att hitta den i källkoden"

#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:21
msgid "Midi player to proof-listen LilyPond-generated MIDI files"
msgstr "MIDI-spelare för att provlyssna på MIDI-filer som LilyPond har skapat"

#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:22
msgid "Midi capturing to enter music"
msgstr "Mata in noter med ett MIDI-instrument"

#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:23
msgid "Powerful Score Wizard to quickly setup a music score"
msgstr "Skapa snabbt ett partitur med partiturguiden"

#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:24
msgid "Snippet Manager to store and apply text snippets, templates or scripts"
msgstr "Spara och använd kodsnuttar, mallar och skript med kodsnuttshanteraren"

#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:25
msgid ""
"Use multiple versions of LilyPond, automatically selects the correct version"
msgstr ""
"Använd flera versioner av LilyPond och låt Frescobaldi välja rätt version "
"automatiskt"

#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:26
msgid "Built-in LilyPond documentation browser and built-in User Guide"
msgstr "Inbyggd läsare för LilyPonds dokumentation och inbyggd användarhandbok"

#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:27
msgid ""
"Smart layout-control functions like coloring specific objects in the PDF"
msgstr "Styr notlayouten och färglägg enskilda objekt i PDF-filen"

#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:28
msgid "MusicXML, Midi and ABC import"
msgstr "Import av MusicXML, MIDI och ABC"

#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:29
msgid ""
"Modern user interface with configurable colors, fonts and keyboard shortcuts"
msgstr ""
"Modernt gränssnitt med anpassningsbara färger, typsnitt och kortkommandon"

#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:30
msgid ""
"Translated into the following languages: Dutch, English, French, German, "
"Italian, Czech, Russian, Spanish, Galician, Turkish, Polish, Brazilian "
"Portuguese and Ukrainian."
msgstr ""
"Översatt till nederländska, engelska, franska, tyska, italienska, tjeckiska, "
"ryska, spanska, galiciska, turkiska, polska, brasiliansk portugisiska och "
"ukrainska."

#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:32
msgid ""
"Frescobaldi is designed to run on all major operating systems (Linux, macOS "
"and Windows). It is named after Girolamo Frescobaldi (1583-1643), an Italian "
"composer of keyboard music in the late Renaissance and early Baroque period."
msgstr ""
"Frescobaldi är utvecklat för de vanligaste operativsystemen (Linux, macOS och"
" Windows). Programmet är uppkallat efter Girolamo Frescobaldi (1583–1643), en"
" italiensk kompositör som skrev musik för klaverinstrument under "
"senrenässansen och den tidiga barocken."

#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:49
msgid "Text editor and music view"
msgstr "Textredigerare och musikvy"

#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:53
msgid "Zoom with the magnifier glass"
msgstr "Förstora med förstoringsglaset"

#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:57
msgid "Syntax highlighting and automatic completion"
msgstr "Syntaxmarkering och automatisk komplettering"

#: ../../linux/org.frescobaldi.Frescobaldi.metainfo.xml.in:61
msgid "Score Wizard to quickly setup a music score"
msgstr "Skapa snabbt ett partitur med partiturguiden"
